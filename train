# Enhanced YOLO Training Configuration - Updated for Latest Version
from ultralytics import YOLO

# Initialize model
model = YOLO('yolov8n.pt')  # atau model lain sesuai kebutuhan

# Enhanced training configuration dengan parameter yang valid
result = model.train(
    data='/content/data.yaml',
    epochs=200,
    imgsz=1240,
    batch=8,
    patience=30,
    optimizer='AdamW',
    box=0.05,
    cls=0.3,
    rect=True,
    cache=True,
    
    # AUGMENTASI UNTUK DATA SEDIKIT
    augment=True,
    degrees=20.0,          # Rotasi random ±20 derajat
    translate=0.1,         # Translasi 10% dari ukuran gambar
    scale=0.9,            # Scale 90-110% dari ukuran asli
    shear=2.0,            # Shear transformation ±2 derajat
    perspective=0.0001,    # Perspective transformation
    flipud=0.5,           # Flip vertical 50% probability
    fliplr=0.5,           # Flip horizontal 50% probability
    
    # AUGMENTASI WARNA UNTUK GAMBAR GRAYSCALE/SATURASI RENDAH
    hsv_h=0.015,          # Hue augmentation (±1.5% dari 360°)
    hsv_s=0.7,            # Saturation augmentation (±70%)
    hsv_v=0.4,            # Brightness/Value augmentation (±40%)
    
    # MOSAIC DAN MIXUP UNTUK AUGMENTASI LANJUTAN
    mosaic=1.0,           # Mosaic augmentation probability
    mixup=0.2,            # MixUp augmentation probability
    copy_paste=0.3,       # Copy-paste augmentation untuk objek kecil
    
    # LEARNING RATE SCHEDULING
    lr0=0.01,            # Initial learning rate
    lrf=0.01,            # Final learning rate (lr0 * lrf)
    momentum=0.937,       # SGD momentum/Adam beta1
    weight_decay=0.0005,  # Optimizer weight decay 5e-4
    warmup_epochs=3.0,    # Warmup epochs
    warmup_momentum=0.8,  # Warmup initial momentum
    warmup_bias_lr=0.1,   # Warmup initial bias lr
    
    # ADDITIONAL SETTINGS UNTUK PERFORMA
    amp=True,            # Automatic Mixed Precision
    fraction=1.0,        # Dataset fraction untuk training
    profile=False,       # Profile ONNX dan TensorRT speeds
    freeze=None,         # Freeze layers: backbone=10, all=24
    
    # UNTUK MONITORING
    plots=True,          # Save training plots
    save_json=True,      # Save results dalam JSON
    conf=0.001,          # Confidence threshold untuk NMS
    iou=0.6,             # IoU threshold untuk NMS
    max_det=300,         # Maximum detections per image
    half=False,          # Use half precision (FP16)
    dnn=False,           # Use OpenCV DNN untuk ONNX inference
    
    # PROJECT DAN NAME
    project='runs/detect',  # Project directory
    name='exp',            # Experiment name
    exist_ok=False,        # Overwrite existing experiment
    
    # ADDITIONAL AUGMENTATIONS UNTUK EDGE CASES
    erasing=0.4,          # Random erasing probability (untuk occlusion)
    
    # DROPOUT UNTUK REGULARIZATION (jika model mendukung)
    dropout=0.1,          # Dropout rate
)
